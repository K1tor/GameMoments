<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GameMoments.App</RootNamespace>
    <AssemblyName>GameMoments</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Description>GameMoments 精彩时刻：Windows 即时回放录制工具。</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameMoments.Core\GameMoments.Core.csproj" />
  </ItemGroup>

</Project>
