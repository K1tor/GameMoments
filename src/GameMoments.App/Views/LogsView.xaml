<UserControl x:Class="GameMoments.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:logging="clr-namespace:GameMoments.Core.Logging;assembly=GameMoments.Core"
             d:DesignHeight="700" d:DesignWidth="900"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,0,10,24">

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="日志与诊断" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="日志只写入本机数据目录，不包含窗口标题、账号或画面内容；导出诊断包前请确认其中没有你不想分享的信息。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新" Padding="14,8" Click="Refresh_Click" />
                        <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="14,8" Click="OpenFolder_Click" />
                        <Button Content="导出诊断包…" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Padding="14,8" Click="Export_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Height="40" Background="{StaticResource SurfaceAltBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="类别" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="消息" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type logging:LogEntry}">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="16,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Info">
                                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                            <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Detail}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="暂无日志。" Margin="16,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="2,12,0,0">
                <Run Text="数据目录：" />
                <Run Text="{Binding DataFolderText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
