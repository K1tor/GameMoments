<UserControl x:Class="GameMoments.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameMoments.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <!-- 环境错误提示 -->
            <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A2A2E"
                    Margin="0,0,0,14" Padding="16,12"
                    Visibility="{Binding ShowSetupBanner, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="录制环境未就绪" FontWeight="SemiBold" Foreground="#FFB4B6" />
                    <TextBlock Text="{Binding SetupErrorText}" TextWrapping="Wrap" Margin="0,6,0,10"
                               Foreground="#F0C9CB" FontSize="12.5" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开设置" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="OpenSettings_Click" />
                        <Button Content="查看日志" Style="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0" Click="OpenLogs_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主控卡片 -->
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StateText}" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding AudioWarning}" Foreground="{StaticResource AmberBrush}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="{Binding CacheText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource BorderBrush}" />
                            <TextBlock Text="{Binding FpsText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource BorderBrush}" />
                            <TextBlock Text="{Binding ProfileText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100"
                                     Value="{Binding CachePercent, Mode=OneWay}"
                                     Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0" Width="210">
                        <Button Style="{StaticResource PrimaryButton}" Padding="16,11" Click="Capture_Click">
                            <TextBlock Text="{Binding CaptureButtonText}" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource {x:Type Button}}" Padding="16,10" Margin="0,9,0,0"
                                Click="Save_Click" IsEnabled="{Binding CanSave}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="保存精彩时刻" />
                                <TextBlock Text="{Binding HotkeySaveText}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="16,9" Margin="0,3,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="Record_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RecordButtonText}" />
                                <TextBlock Text="{Binding HotkeyRecordText}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 三张信息卡 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="画面与编码" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProfileText}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FfmpegText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FfmpegText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="音频" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding AudioText}" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding AudioWarning}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding AudioWarning, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Text="音画时间戳按缓存分段对齐，片段时长误差 ≤ 1 秒。" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="保存位置" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding SaveFolderText}" FontWeight="SemiBold" FontSize="12.5" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <Button Content="打开文件夹" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Padding="0,4" Margin="0,8,0,0" Click="OpenFolder_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近片段 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="最近保存" Style="{StaticResource SectionTitle}" Margin="0" />
                        <Button Content="查看全部 →" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Padding="4,2" Click="OpenLibrary_Click" />
                    </Grid>
                    <TextBlock Text="最近保存的片段会显示在这里，也可以在片段库中查看全部。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding RecentClips}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="12"
                                        Margin="0,0,12,10" Width="300">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="58" Height="36" CornerRadius="6" Background="#0B0D11"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                                <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有保存的片段。开始捕获后按快捷键，或在捕获中点击“保存精彩时刻”。"
                               Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Visibility="{Binding RecentClips.Count, Converter={StaticResource ZeroToVis}}" />
                </StackPanel>
            </Border>

            <!-- 快捷键提示 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" Margin="0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="9,4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding HotkeySaveText}" FontSize="12" />
                            </Border>
                            <TextBlock Text="保存按键前一段画面" Style="{StaticResource Caption}" Margin="9,0,18,0"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="9,4"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding HotkeyRecordText}" FontSize="12" />
                            </Border>
                            <TextBlock Text="开始 / 停止完整录制" Style="{StaticResource Caption}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding HotkeyErrorText}" Foreground="{StaticResource AmberBrush}" FontSize="12"
                                   Margin="0,9,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="修改快捷键" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Padding="4,2" Click="OpenSettings_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
