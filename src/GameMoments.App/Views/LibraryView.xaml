<UserControl x:Class="GameMoments.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameMoments.App.Converters">
    <UserControl.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />

        <Style x:Key="ClipItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                                Padding="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4356" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Grid Width="280">
                    <TextBox x:Name="SearchBox" ToolTip="按文件名搜索"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="搜索文件名…" Foreground="{StaticResource MutedBrush}" FontSize="13"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="刷新" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="Refresh_Click" />
                <Button Content="打开保存目录" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="OpenFolder_Click" />
            </StackPanel>
            <TextBlock Text="{Binding ClipCountText}" Style="{StaticResource Caption}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid>
            <ListBox x:Name="ClipList" ItemsSource="{Binding Clips}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ClipItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="140" Height="79" CornerRadius="8" Background="#0B0D11"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0">
                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding FpsText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                    <Run Text="{Binding CreatedText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding AudioText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding SourceText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="播放" Style="{StaticResource PrimaryButton}" Padding="13,6"
                                        Click="Play_Click" />
                                <Button Content="位置" Padding="11,6" Margin="6,0,0,0" Click="Reveal_Click" />
                                <Button Content="重命名" Padding="11,6" Margin="6,0,0,0" Click="Rename_Click" />
                                <Button Content="删除" Style="{StaticResource DangerButton}" Padding="11,6"
                                        Margin="6,0,0,0" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Clips.Count, Converter={StaticResource ZeroToVis}}">
                <TextBlock Text="📚" FontSize="42" HorizontalAlignment="Center" Opacity="0.7" />
                <TextBlock Text="片段库还是空的" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="开始捕获后按快捷键保存，片段会出现在这里。" Style="{StaticResource Caption}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>

